# Terraform working directories
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files
*.tfvars
*.tfvars.json

# Keep example variable files
!*.tfvars.example

# Terraform plan files
*.tfplan
tfplan

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# AWS credentials and keys
.aws/
*.pem
*.key
credentials

# Lambda build artifacts
*.zip
lambda/package/
lambda/**/__pycache__/
lambda/**/*.pyc

# Python
.pytest_cache/
.coverage
venv/
.venv/

# IDE and operating system
.idea/
.vscode/
.DS_Store

# Logs
*.log

# Environment files
.env
.env.*
!.env.example